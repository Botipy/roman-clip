{
  "name": "roman-clip",
  "productName": "Roman Clip",
  "version": "0.3.0",
  "description": "Lightweight instant-replay clipping tool for Windows: save the last seconds of your screen with a hotkey or a voice command",
  "main": "main.js",
  "author": "Botipy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.botipy.romanclip",
    "publish": [
      {
        "provider": "github",
        "owner": "Botipy",
        "repo": "roman-clip"
      }
    ],
    "productName": "Roman Clip",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "assets/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Roman-Clip-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Roman Clip",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "vosk-browser": "^0.0.8"
  },
  "homepage": "https://github.com/Botipy/roman-clip#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Botipy/roman-clip.git"
  },
  "bugs": {
    "url": "https://github.com/Botipy/roman-clip/issues"
  },
  "keywords": [
    "clips",
    "instant-replay",
    "screen-recorder",
    "ffmpeg",
    "electron",
    "windows",
    "game-clips",
    "voice-command"
  ]
}
